# Secretos — NUNCA subir
.env

# Memoria del chat (datos personales)
memoria_*.json
# Última posición del avatar del modo escritorio
escritorio_estado.json
# Frases fijas del avatar ya sintetizadas (frases_voz.py)
cache_frases/

# Python
__pycache__/
*.pyc
*.pyo

# Audio de pruebas / salidas de TTS
*.mp3
*.wav
pruebas_voz/
tmp_audio/

# Modelos de terceros: no se versionan (licencias de terceros; ver models/README.md).
# Los de RVC ya no se usan.
rmvpe.pt
hubert_base.pt
models/Rem_600e_6600s/
models/**/*.pth
models/**/*.index

# Modelos VRM del avatar (models/vrm/): solo locales, nunca se versionan,
# estén donde estén — los hooks/ también los rechazan (ver hooks/README.md).
*.vrm
*.VRM
*.glb
models/vrm/*
!models/vrm/README.md

# Modelos de voz Piper: nunca se versionan, estén donde estén (ver hooks/).
*.onnx
*.onnx.json
models/piper/
models/yoru_piper/

# Clips de animación VRMA (descargar manualmente — ver Animaciones/README.md).
# El README sí se versiona; los .vrma y el pack descargado, no.
Animaciones/*
!Animaciones/README.md
# El catálogo sí: solo metadatos (etiquetas, origen, medidas), ningún .vrma.
!Animaciones/catalogo.json

# Entorno virtual
venv/

# Logs en runtime (overlay GTK, WebKit console)
*.log

# Archivos de prueba/debug
fix_pipeline.py

# Preferencias del panel de control (las edita rem_panel, ver preferencias.py)
preferencias.json
preferencias.json.tmp

# Notas y herramientas de trabajo de la fase 2 (avatar de escritorio): análisis de
# Nerumi (no redistribuible), tabla de equivalencias, prototipos. Ver CLAUDE.md,
# "Nota de traspaso".
notas_fase2/
