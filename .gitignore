# Secretos — NUNCA subir
.env

# Memoria del chat (datos personales)
memoria_*.json

# Python
__pycache__/
*.pyc
*.pyo

# Audio de pruebas / salidas de TTS-RVC
*.mp3
*.wav
pruebas_voz/
tmp_audio/

# Modelos ML muy grandes (descargar de HuggingFace/Google Drive — ver INSTALL.md)
rmvpe.pt
hubert_base.pt
models/**/*.pth
models/**/*.index
rem.vrm

# Modelos VRM alternativos (ver README de models/ para la fuente y licencia
# de cada uno) — nunca se versionan, igual que rem.vrm arriba.
*.glb
models/*.vrm

# Clips de animación VRMA (descargar manualmente — ver Animaciones/README.md).
# El README sí se versiona; los .vrma y el pack descargado, no.
Animaciones/*
!Animaciones/README.md

# Entorno virtual
venv/

# Logs en runtime (overlay GTK, WebKit console)
*.log

# Archivos de prueba/debug
fix_pipeline.py
