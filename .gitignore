# Secretos — NUNCA subir
.env

# Memoria del chat (datos personales)
memoria_*.json

# Python
__pycache__/
*.pyc
*.pyo

# Audio de pruebas / salidas de TTS
*.mp3
*.wav
pruebas_voz/
tmp_audio/

# Modelos ML muy grandes (descargar de HuggingFace/Google Drive — ver INSTALL.md)
rmvpe.pt
hubert_base.pt
models/**/*.pth
models/**/*.index
rem.vrm

# Modelos VRM alternativos (ver README de models/ para la fuente y licencia
# de cada uno) — nunca se versionan, igual que rem.vrm arriba.
*.glb
models/*.vrm

# Modelos de voz Piper: nunca se versionan, estén donde estén (ver hooks/).
*.onnx
*.onnx.json
models/piper/
models/yoru_piper/

# Clips de animación VRMA (descargar manualmente — ver Animaciones/README.md).
# El README sí se versiona; los .vrma y el pack descargado, no.
Animaciones/*
!Animaciones/README.md
# El catálogo sí: solo metadatos (etiquetas, origen, medidas), ningún .vrma.
!Animaciones/catalogo.json

# Entorno virtual
venv/

# Logs en runtime (overlay GTK, WebKit console)
*.log

# Archivos de prueba/debug
fix_pipeline.py

# Preferencias del panel de control (las edita rem_panel, ver preferencias.py)
preferencias.json
preferencias.json.tmp
