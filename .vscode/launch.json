{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "bench_chat",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bench_chat.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "avatar (navegador)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:18765/rem_avatar.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Rem: test_voz",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_voz.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--voz", "es-VE-PaolaNeural", "--rate=-8%"]
    },
    {
      "name": "Rem: dump_vrm",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/dump_vrm.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "▶ Rem: bench_chat + avatar",
      "configurations": ["bench_chat", "avatar (navegador)"],
      "stopAll": true
    }
  ]
}